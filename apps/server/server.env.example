# Names of the server's environment variables. Values live in Railway > service > Variables
# (production) or in a file outside the repo loaded with: node --env-file=<path> src/index.ts
# Never commit a filled-in copy.

# development | production. production makes WEB_ORIGIN and DB_PATH required and HOST default 0.0.0.0
NODE_ENV=
# Default 127.0.0.1 (dev) / 0.0.0.0 (production)
HOST=
# Railway injects PORT; default 3000
PORT=
# The SQLite file. Railway: on the volume, e.g. /data/isekai.sqlite (default: <repo>/data/isekai.sqlite)
DB_PATH=
# Origin(s) of the web app allowed by CORS, comma-separated, no path (default: http://localhost:5173)
# e.g. https://<site>.netlify.app
# Dev, two browsers on different origins: WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# (the WebSocket Origin check and CORS accept exactly the listed origins; no wildcard; production requires it to be set)
WEB_ORIGIN=
# scrypt hash of the create code needed to create a game (never the code itself). Make it with:
#   pnpm --silent --filter @isekai/server run create-code:hash   (reads the code from stdin)
# Without it nobody can create a game (POST /api/games answers 503).
CREATE_CODE_HASH=
# scrypt hash of the server owner's admin code (GEN-061): opens the AI usage dashboard at <web>/admin.
# Make it with:  pnpm --silent --filter @isekai/server run admin-code:hash   (reads the code from stdin)
# Without it the dashboard is closed for everyone.
ADMIN_CODE_HASH=

# --- Backups (GEN-037) ---
# Folder for the backup copies (default: backups/ next to DB_PATH). Railway: /data/backups (on the volume)
BACKUP_DIR=
# Hours between backups, default 6; 0 = no backup job. One is also taken at start (if the newest is older) and at shutdown.
BACKUP_INTERVAL_HOURS=
# How many of the newest copies are kept, default 28 (7 days at 6 h)
BACKUP_KEEP=

# --- AI GM (GEN-038) ---
# anthropic (default) | mock (tests / offline dev, no network). Unknown values stop the start.
AI_PROVIDER=
# Secret: Railway > Variables only. Without it (and AI_PROVIDER not mock) the server starts but AI games cannot be created or started.
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5 (Q-018) / claude-haiku-5-5 for memory summaries
AI_MODEL=
AI_SUMMARY_MODEL=
# Per attempt, default 60000
AI_TIMEOUT_MS=
# Extra attempts after timeout / refusal / bad JSON, default 2
AI_MAX_RETRIES=
# Default 1000 (retry n waits n x this)
AI_RETRY_DELAY_MS=
# Ceiling per game per calendar month (UTC) in USD, default 20 (Q-018)
AI_GAME_MONTHLY_USD=
