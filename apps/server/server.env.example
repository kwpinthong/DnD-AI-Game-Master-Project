# Names of the server's environment variables. Values live in Railway > service > Variables
# (production) or in a file outside the repo loaded with: node --env-file=<path> src/index.ts
# Never commit a filled-in copy.

# development | production. production makes WEB_ORIGIN and DB_PATH required and HOST default 0.0.0.0
NODE_ENV=
# Default 127.0.0.1 (dev) / 0.0.0.0 (production)
HOST=
# Railway injects PORT; default 3000
PORT=
# The SQLite file. Railway: on the volume, e.g. /data/isekai.sqlite (default: <repo>/data/isekai.sqlite)
DB_PATH=
# Origin(s) of the web app allowed by CORS, comma-separated, no path (default: http://localhost:5173)
# e.g. https://<site>.netlify.app
WEB_ORIGIN=
# Optional: invite code of a game created at start if none has it (until GEN-025 adds game creation)
BOOTSTRAP_INVITE_CODE=

# --- AI GM (GEN-038) ---
# anthropic (default) | mock (tests / offline dev, no network). Unknown values stop the start.
AI_PROVIDER=
# Secret: Railway > Variables only. Without it (and AI_PROVIDER not mock) the server starts but AI games cannot be created or started.
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5 (Q-018) / claude-haiku-5-5 for memory summaries
AI_MODEL=
AI_SUMMARY_MODEL=
# Per attempt, default 60000
AI_TIMEOUT_MS=
# Extra attempts after timeout / refusal / bad JSON, default 2
AI_MAX_RETRIES=
# Default 1000 (retry n waits n x this)
AI_RETRY_DELAY_MS=
# Ceiling per game per calendar month (UTC) in USD, default 20 (Q-018)
AI_GAME_MONTHLY_USD=
