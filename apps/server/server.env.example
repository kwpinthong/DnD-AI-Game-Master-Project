# Names of the server's environment variables. Values live in Railway > service > Variables
# (production) or in a file outside the repo loaded with: node --env-file=<path> src/index.ts
# Never commit a filled-in copy.

# development | production. production makes WEB_ORIGIN and DB_PATH required and HOST default 0.0.0.0
NODE_ENV=
# Default 127.0.0.1 (dev) / 0.0.0.0 (production)
HOST=
# Railway injects PORT; default 3000
PORT=
# The SQLite file. Railway: on the volume, e.g. /data/isekai.sqlite (default: <repo>/data/isekai.sqlite)
DB_PATH=
# Origin(s) of the web app allowed by CORS, comma-separated, no path (default: http://localhost:5173)
# e.g. https://<site>.netlify.app
WEB_ORIGIN=
# scrypt hash of the create code needed to create a game (never the code itself). Make it with:
#   pnpm --silent --filter @isekai/server run create-code:hash   (reads the code from stdin)
# Without it nobody can create a game (POST /api/games answers 503).
CREATE_CODE_HASH=
