# Copy outside the repo (e.g. C:\isekai\config\server.env) and load with: node --env-file=<path>
# Never commit a filled-in copy.
HOST=127.0.0.1
PORT=3000
# Directory that holds isekai.sqlite (default: <repo>/data)
DATA_DIR=
# Origin(s) of the web app allowed by CORS, comma-separated (default: http://localhost:5173)
# e.g. https://<site>.netlify.app
WEB_ORIGIN=
