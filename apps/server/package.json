{
  "name": "@isekai/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@isekai/protocol": "workspace:*",
    "@isekai/rules": "workspace:*",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
