{
  "name": "isekai-chronicles",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @isekai/server --filter @isekai/web dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "lint": "pnpm run typecheck",
    "typecheck": "pnpm -r typecheck && pnpm run typecheck:infra",
    "typecheck:infra": "tsc -p .railway/tsconfig.json",
    "db:generate": "pnpm --filter @isekai/server db:generate",
    "db:migrate": "pnpm --filter @isekai/server db:migrate",
    "db:backup": "pnpm --filter @isekai/server db:backup",
    "db:restore": "pnpm --filter @isekai/server db:restore",
    "assets:import": "pnpm --filter @isekai/server assets:import"
  },
  "devDependencies": {
    "railway": "3.17.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
